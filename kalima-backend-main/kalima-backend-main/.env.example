# Copy to .env and adjust. Spring Boot reads these when exported to the environment
# (or use your orchestration secret store).

# ── Deploying (e.g. Railway) ──────────────────────────────────────
# 1. Set SPRING_PROFILES_ACTIVE=prod — without it, application-prod.properties (CORS,
#    server.port=${PORT}, error message hiding, refresh-cookie SameSite=None) never loads.
# 2. Railway's own Postgres plugin exposes PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD (and a
#    non-JDBC DATABASE_URL) — none of which match DB_URL/DB_USERNAME/DB_PASSWORD below as-is.
#    Set them explicitly, e.g.:
#      DB_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
#      DB_USERNAME=${{Postgres.PGUSER}}
#      DB_PASSWORD=${{Postgres.PGPASSWORD}}
# 3. File uploads (KALIMA_*_STORAGE_DIR below) are written to local disk, which most container
#    platforms (Railway included) wipe on every redeploy/restart. Mount a persistent Volume at
#    that path (or migrate to object storage) before relying on uploaded documents in production.
# SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:postgresql://localhost:5432/Kalima_dev_v2
DB_USERNAME=postgres
DB_PASSWORD=

# Regex of trusted reverse-proxy IPs (used by Tomcat RemoteIpValve to validate X-Forwarded-For).
# Single IP: 172\.16\.0\.5   |  Multiple: 172\.16\.0\.5|172\.16\.0\.6
# Leave unset in local dev (defaults to 172\.16\.0\.5 which is unused locally — safe).
# IMPORTANT for hosted platforms (Railway, etc.): 172.16.0.5 is almost certainly NOT your
# platform's actual edge-proxy IP. Find the real one (platform docs / by inspecting
# X-Forwarded-For in logs) and set it here, or IP-based login rate limiting and audit-log
# IPs will be attributed to the proxy instead of the real client.
# TRUSTED_PROXY_IPS=172\.16\.0\.5

# Must be at least 32 characters. Generate a real random value for production —
# never reuse the placeholder from local .env.
JWT_SECRET=

# Optional. Access token TTL in minutes (default 30 if unset). Increase for local dev if needed.
# JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30

# Optional. Login rate limits (POST /api/auth/login only). Defaults match application.properties.
# KALIMA_AUTH_LOGIN_RATE_LIMIT_ENABLED=true
# KALIMA_AUTH_LOGIN_MAX_IP=20
# KALIMA_AUTH_LOGIN_MAX_EMAIL=10
# KALIMA_AUTH_LOGIN_WINDOW_MINUTES=15

# Comma-separated browser origins. Required in production (profile prod) for SPA; if unset, CORS is off for cross-origin.
# Production (Vercel frontend):
# CORS_ALLOWED_ORIGINS=https://kalima-frontend.vercel.app

# SameSite for the refresh-token cookie. application-prod.properties already defaults this
# to None (required when frontend and backend are on different domains, e.g. Vercel + Railway
# default domains — browsers drop Strict/Lax cookies on cross-site requests). If you instead
# put the frontend and backend under the same registrable domain (app.example.com /
# api.example.com), set this to Strict for stronger CSRF protection.
# KALIMA_AUTH_REFRESH_COOKIE_SAME_SITE=None

# ── Lawyer Assistant (Google Gemini) ─────────────────────────────
# Required to enable POST /api/lawyer-assistant/ask. Get a free key at
# https://aistudio.google.com/app/apikey . If unset, the endpoint returns 503.
GEMINI_API_KEY=
# Optional overrides (defaults shown):
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_MAX_OUTPUT_TOKENS=800
# GEMINI_TEMPERATURE=0.4

# ── Lawyer Assistant fallback (Groq) ─────────────────────────────
# Optional but recommended for dev: if Gemini returns 429/503, the backend
# falls back to Groq automatically.
GROQ_API_KEY=
# Optional overrides (defaults shown):
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# GROQ_TIMEOUT_SECONDS=30
# GROQ_MAX_OUTPUT_TOKENS=800
# GROQ_TEMPERATURE=0.4

# ── ChatGPT Voice–style speech (optional) ────────────────────────
# Azure neural Arabic TTS (recommended for clear voice):
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus
# AZURE_SPEECH_VOICE=ar-EG-SalmaNeural
# Groq Whisper STT uses GROQ_API_KEY above (no extra key).

# ── OCR module (Azure Document Intelligence in Phase 2) ───────────
# KALIMA_OCR_ENABLED=true
# KALIMA_OCR_STORAGE_DIR=uploads/ocr
# KALIMA_OCR_AUTO_PROCESS=true
# KALIMA_OCR_PROVIDER=AZURE_DI
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
# AZURE_DOCUMENT_INTELLIGENCE_KEY=
# Optional:
# KALIMA_OCR_AZURE_API_VERSION=2024-11-30
# KALIMA_OCR_AZURE_MODEL=prebuilt-read
