# Render free tier (512 MB RAM). Lighter build + runtime than Dockerfile (Cloud Run).
FROM eclipse-temurin:17-jdk AS build

WORKDIR /app

# Cache Maven dependencies in a separate layer (faster rebuilds, less peak RAM).
COPY mvnw pom.xml ./
COPY .mvn .mvn
RUN chmod +x mvnw

ENV MAVEN_OPTS="-Xmx384m -XX:+TieredCompilation -XX:TieredStopAtLevel=1"
RUN ./mvnw dependency:go-offline -B -q || true

COPY src ./src
RUN ./mvnw package -DskipTests -B -q

FROM eclipse-temurin:17-jre

WORKDIR /app

COPY --from=build /app/target/kalima-backend-0.0.1-SNAPSHOT.jar app.jar
COPY docker-entrypoint.render.sh /docker-entrypoint.render.sh
RUN chmod +x /docker-entrypoint.render.sh

EXPOSE 8080

ENV SPRING_PROFILES_ACTIVE=prod
ENV JAVA_OPTS="-XX:+UseContainerSupport -Xms64m -Xmx180m -Xss512k -XX:+UseSerialGC -XX:MaxMetaspaceSize=96m -XX:ReservedCodeCacheSize=32m"

ENTRYPOINT ["/docker-entrypoint.render.sh"]
